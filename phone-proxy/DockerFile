FROM python:3.11-slim

# Rust + системные зависимости
RUN apt-get update && apt-get install -y \
    curl \
    build-essential \
    git \
    && curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y \
    && apt-get clean

ENV PATH="/root/.cargo/bin:${PATH}"

WORKDIR /app

# Python-зависимости
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Rust-зависимости для TeleSpotter
COPY telespotter/Cargo.toml telespotter/Cargo.lock ./telespotter/
WORKDIR /app/telespotter
RUN cargo fetch || true

# Копируем исходники TeleSpotter и собираем
WORKDIR /app
COPY telespotter/ ./telespotter/
WORKDIR /app/telespotter
RUN cargo build --release

# Возвращаемся
WORKDIR /app
COPY . .

# Порт
EXPOSE 10000

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "10000"]
